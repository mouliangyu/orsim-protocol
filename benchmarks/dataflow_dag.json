{
  "protocol": "orsim/v1",
  "block_id": "multi_state_dag",
  "source": [
    "seed = r1; a = r2; b = r3; c = r4;",
    "for (i = 0; i < 24; i++) {",
    "    p = a + b;",
    "    q = b + c;",
    "    next_a = p + seed;",
    "    next_b = q + p;",
    "    next_c = next_a + q;",
    "    a = next_a; b = next_b; c = next_c;",
    "}",
    "r5 = a; r6 = b; r7 = c;"
  ],
  "bit_width": 3,
  "time_limit_ms": 1000,
