  "source": [
    "state = [r1, r2, r3, r4, r5];",
    "for (layer, a, b) in [(0, r6 != 0, r7 != 0), (1, r8 != 0, r9 != 0)] {",
    "    x[i] = state[(i + a) % 5]; p[i] = x[i] + x[(i + 1) % 5];",
    "    q = [p[0]+p[b ? 2 : 3], p[1]+p[3], p[2]+p[4]];",
    "    state = [q[0]+q[1], q[1]+q[2], q[2]+p[0], q[0]+p[3], (q[0]+q[1])+(q[2]+p[0])];",
    "    x[i] = state[(i + a + 1) % 5]; p[i] = x[i] + x[(i + 1) % 5];",
    "    q = [p[0]+p[b ? 3 : 2], p[1]+p[4], p[2]+p[3]];",
    "    state = [q[0]+q[2], q[1]+p[0], q[2]+q[1], q[0]+p[4], (q[0]+q[2])+(q[0]+p[4])];",
    "}",
    "[r10, r11, r12, r13, r14] = state;",
    "r15 = sum(state);",
    "// Four predecessors enter each join; five state values cross both joins."
  ],
  "bit_width": 3,
