  "source": [
    "a = (r5 != 0); b = (r6 != 0); c = (r7 != 0); d = (r8 != 0);",
    "x = a ? r1*r2 : r1+r2;",
    "y = b ? r2*r3 : r2+r3;",
    "z = (a ^ b) ? r3*r4 : r3+r4;",
    "w = x+z;",
    "p = x+y; q = z+w;",
    "t = c ? p*q : p+q;",
    "u = d ? z*w : z+w;",
    "v = (c ^ d) ? t+u : t*u;",
    "r9 = t+u+v; r10=t; r11=u; r12=v;",
    "// Four predecessors enter each join; common successors use aligned t# operands."
  ],
