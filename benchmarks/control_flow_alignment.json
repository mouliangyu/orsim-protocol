{
  "protocol": "orsim/v1",
  "block_id": "control_flow_alignment",
  "source": [
    "if (r5 != 0) { x = r1 * r2; y = r3 + r4; z = x * y; }",
    "else         { x = r1 + r2; y = r3 * r4; z = x + y; }",
    "p = x + y; q = p * z;",
    "if (r6 != 0) { t = p + q; u = x * y; }",
    "else         { t = p * y; u = x + q; }",
    "v = t + u; r7 = t * u + v;",
    "r8 = t; r9 = u; r10 = v;",
    "// At both joins, t#3/t#2/t#1 name the same three logical values on either path."
  ],
  "bit_width": 3,
  "instructions": [
