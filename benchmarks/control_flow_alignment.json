    {"op": "GET","dst": "g","reg": "r6"},
    {"op": "BR","cond": "g","target": "true2"},
    {"op": "MUL","dst": "t","lhs": "p","rhs": "y"},
    {"op": "ADD","dst": "u","lhs": "x","rhs": "q"},
    {"op": "ADD","dst": "v","lhs": "t","rhs": "u"},
    {"op": "JMP","target": "join2"},
    {"op": "LABEL","name": "true2"},
    {"op": "ADD","dst": "t","lhs": "p","rhs": "q"},
